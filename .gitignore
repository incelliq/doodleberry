# generated renders and intermediates (final films are copied out of build/)
films/*/build/
out/
__pycache__/
*.pyc
node_modules/
# derived aspect-ratio cuts (films/<name>--16x9), rebuilt by film.render aspect=...
films/*--*/
# generated brand assets (python -m dbe brand.assets)
brand/out/
# third-party asset packs placed locally (licences recorded in assets/manifest.json "external"); rebuilt puppets
assets/external/
cast/external/
tmp_imp/
# production registry, session logs and render copies for the board (plan 3.7; machine-local)
productions/
# per-film session notes in workspaces
.production/

# scratch copies of films made (and removed) by python -m dbe test
films/zz-*/

# team state and audit log (WP-39; machine-local: who holds which lock, and who changed what)
team/state.json
team/audit.jsonl
