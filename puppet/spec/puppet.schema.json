{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://doodleberry.dev/schema/puppet-0.5.json",
 "title": "Doodleberry puppet v0.5",
 "type": "object",
 "required": [
  "format",
  "version",
  "name",
  "template",
  "artboard",
  "ground",
  "palette",
  "parts",
  "swaps"
 ],
 "properties": {
  "format": {
   "const": "doodleberry.puppet"
  },
  "version": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "template": {
   "type": "string"
  },
  "artboard": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "ground": {
   "type": "number"
  },
  "palette": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^#[0-9a-fA-F]{6}$"
   }
  },
  "parts": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/part"
   }
  },
  "swaps": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/swap"
   }
  },
  "meta": {
   "type": "object"
  },
  "views": {
   "type": "object",
   "description": "v0.2: named views overriding parts (strokes/pivot/z) and swap shapes",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "parts": {
      "type": "object"
     },
     "swaps": {
      "type": "object"
     }
    }
   }
  },
  "springs": {
   "type": "object",
   "description": "v0.2: secondary motion per part",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "driver": {
      "type": "string"
     },
     "freq": {
      "type": "number"
     },
     "damping": {
      "type": "number"
     },
     "gain": {
      "type": "number"
     },
     "limit": {
      "type": "number"
     }
    },
    "required": [
     "driver"
    ]
   }
  },
  "poses": {
   "type": "object",
   "description": "v0.2: named key poses",
   "additionalProperties": {
    "type": "object"
   }
  },
  "acting": {
   "type": "object",
   "description": "v0.5: per-character acting defaults",
   "properties": {
    "viseme_hold": {
     "type": "number"
    },
    "tempo": {
     "type": "number"
    },
    "fade": {
     "type": "number"
    },
    "idle": {
     "type": "number"
    },
    "energy": {
     "type": "number"
    }
   }
  }
 },
 "$defs": {
  "stroke": {
   "oneOf": [
    {
     "$ref": "#/$defs/vector"
    },
    {
     "$ref": "#/$defs/raster"
    },
    {
     "$ref": "#/$defs/mesh"
    }
   ]
  },
  "part": {
   "type": "object",
   "required": [
    "pivot",
    "strokes"
   ],
   "properties": {
    "parent": {
     "type": [
      "string",
      "null"
     ]
    },
    "pivot": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "z": {
     "type": "number"
    },
    "strokes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/stroke"
     }
    }
   }
  },
  "swap": {
   "type": "object",
   "required": [
    "anchor",
    "shapes"
   ],
   "properties": {
    "anchor": {
     "type": "string"
    },
    "z": {
     "type": "number"
    },
    "talk": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "movable": {
     "type": "number"
    },
    "replaces": {
     "type": "string"
    },
    "shapes": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/stroke"
      }
     }
    }
   }
  },
  "vector": {
   "type": "object",
   "required": [
    "d"
   ],
   "properties": {
    "d": {
     "type": "string"
    },
    "fill": {
     "type": "string"
    },
    "stroke": {
     "type": "string"
    },
    "width": {
     "type": "number"
    },
    "opacity": {
     "type": "number"
    },
    "rule": {
     "enum": [
      "nonzero",
      "evenodd"
     ]
    }
   }
  },
  "raster": {
   "type": "object",
   "description": "v0.3: an image placed in artboard units",
   "required": [
    "image",
    "x",
    "y",
    "w",
    "h"
   ],
   "properties": {
    "image": {
     "type": "string"
    },
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "w": {
     "type": "number"
    },
    "h": {
     "type": "number"
    },
    "opacity": {
     "type": "number"
    }
   }
  },
  "mesh": {
   "type": "object",
   "description": "v0.5: a texture on a skinned triangle mesh",
   "required": [
    "mesh"
   ],
   "properties": {
    "opacity": {
     "type": "number"
    },
    "mesh": {
     "type": "object",
     "required": [
      "image",
      "iw",
      "ih",
      "verts",
      "uv",
      "tris",
      "weights"
     ],
     "properties": {
      "image": {
       "type": "string"
      },
      "iw": {
       "type": "number"
      },
      "ih": {
       "type": "number"
      },
      "grow": {
       "type": "number"
      },
      "verts": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "uv": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "tris": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "integer"
        },
        "minItems": 3,
        "maxItems": 3
       }
      },
      "weights": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "array",
         "prefixItems": [
          {
           "type": "string"
          },
          {
           "type": "number"
          }
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}