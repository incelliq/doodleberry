  },
  {
   "id": "q1",
   "speaker": "momo",
   "fact": null,
   "text": "Why does a telescope show things we cannot see?",
   "start": 4.411,
   "end": 8.661,
   "align": "model",
   "slot": [
    4.411,
    4.25
   ],
   "voice_end": 6.743,
   "words": [
    {
     "text": "Why",
     "start": 4.39,
     "end": 4.565
    },
    {
     "text": "does",
     "start": 4.59,
     "end": 4.69
    },
    {
     "text": "a",
     "start": 4.715,
     "end": 4.74
    },
    {
     "text": "telescope",
     "start": 4.79,
     "end": 5.39
    },
    {
     "text": "show",
     "start": 5.44,
     "end": 5.59
    },
    {
     "text": "things",
     "start": 5.665,
