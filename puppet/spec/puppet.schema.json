{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://doodleberry.dev/schema/puppet-0.5.json",
 "title": "Doodleberry puppet v0.5",
 "type": "object",
 "required": [
  "format",
  "version",
  "name",
  "template",
  "artboard",
  "ground",
  "palette",
  "parts",
  "swaps"
 ],
 "properties": {
  "format": {
   "const": "doodleberry.puppet"
  },
  "version": {
   "type": "string"
  },
  "name": {
   "type": "string"
  },
  "template": {
   "type": "string"
  },
  "artboard": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2,
   "maxItems": 2
  },
  "ground": {
   "type": "number"
  },
  "palette": {
   "type": "object",
   "additionalProperties": {
    "type": "string",
    "pattern": "^#[0-9a-fA-F]{6}$"
   }
  },
  "parts": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/part"
   }
  },
  "swaps": {
   "type": "object",
   "additionalProperties": {
    "$ref": "#/$defs/swap"
   }
  },
  "meta": {
   "type": "object"
  },
  "views": {
   "type": "object",
   "description": "v0.2: named views overriding parts (strokes/pivot/z) and swap shapes",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "parts": {
      "type": "object"
     },
     "swaps": {
      "type": "object"
     }
    }
   }
  },
  "springs": {
   "type": "object",
   "description": "v0.2: secondary motion per part",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "driver": {
      "type": "string"
     },
     "freq": {
      "type": "number"
     },
     "damping": {
      "type": "number"
     },
     "gain": {
      "type": "number"
     },
     "limit": {
      "type": "number"
     }
    },
    "required": [
     "driver"
    ]
   }
  },
  "poses": {
   "type": "object",
   "description": "v0.2: named key poses ({angles}; v0.9: an optional z map sets layer order while the pose holds)",
   "additionalProperties": {
    "type": "object"
   }
  },
  "acting": {
   "type": "object",
   "description": "v0.5/v0.6: per-character acting defaults",
   "properties": {
    "viseme_hold": {
     "type": "number"
    },
    "tempo": {
     "type": "number"
    },
    "fade": {
     "type": "number"
    },
    "idle": {
     "type": "number"
    },
    "energy": {
     "type": "number"
    },
    "principles": {
     "type": "object",
     "description": "v0.6: anticipation and overshoot (unsharp mask in time on the clip pose)",
     "properties": {
      "snap": {
       "type": "number"
      },
      "window": {
       "type": "number"
      }
     }
    }
   }
  },
  "chains": {
   "type": "object",
   "description": "v0.6: FABRIK chains (tails, tentacles, ropes)",
   "additionalProperties": {
    "type": "object",
    "required": [
     "parts",
     "tip"
    ],
    "properties": {
     "parts": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "minItems": 2
     },
     "tip": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "wave": {
      "type": "object",
      "properties": {
       "amp": {
        "type": "number"
       },
       "freq": {
        "type": "number"
       },
       "lag": {
        "type": "number"
       }
      }
     }
    }
   }
  },
  "clips": {
   "type": "object",
   "description": "v0.7: this character's own clips (same shape as a clip library entry: duration, loop, tracks, offset, swaps, contacts), recorded in the Rig Canvas; they win over library clips of the same name",
   "additionalProperties": {
    "type": "object",
    "required": [
     "duration"
    ],
    "properties": {
     "duration": {
      "type": "number"
     },
     "loop": {
      "type": "boolean"
     },
     "tracks": {
      "type": "object"
     },
     "offset": {
      "type": "array"
     },
     "swaps": {
      "type": "object"
     },
     "contacts": {
      "type": "object"
     },
     "controls": {
      "type": "object",
      "description": "v0.10: control tracks {control: [[t, value], ...]} in clip time, added to the timeline's own keys while the clip plays",
      "additionalProperties": {
       "type": "array"
      }
     },
     "fadeIn": {
      "type": "number",
      "minimum": 0,
      "description": "v0.8: default blend-in seconds when a timeline plays this clip (drawn levels: 0)"
     },
     "fadeOut": {
      "type": "number",
      "minimum": 0,
      "description": "v0.8: default blend-out seconds (drawn levels: 0)"
     }
    }
   }
  },
  "lipsync": {
   "type": "object",
   "description": "v0.9: phoneme poses for the whole face: mouth shape -> {angles, shifts, scales}, cross-faded as the mouth changes",
   "additionalProperties": {
    "type": "object",
    "properties": {
     "angles": {
      "type": "object"
     },
     "shifts": {
      "type": "object"
     },
     "scales": {
      "type": "object"
     }
    }
   }
  },
  "copy_rotation": {
   "type": "array",
   "description": "v0.9: copy-rotation constraints [{part, from, factor, offset, weight}]",
   "items": {
    "type": "object",
    "required": [
     "part",
     "from"
    ],
    "properties": {
     "part": {
      "type": "string"
     },
     "from": {
      "type": "string"
     },
     "factor": {
      "type": "number"
     },
     "offset": {
      "type": "number"
     },
     "weight": {
      "type": "number"
     }
    }
   }
  }
 },
 "$defs": {
  "stroke": {
   "oneOf": [
    {
     "$ref": "#/$defs/vector"
    },
    {
     "$ref": "#/$defs/raster"
    },
    {
     "$ref": "#/$defs/mesh"
    }
   ]
  },
  "part": {
   "type": "object",
   "required": [
    "pivot",
    "strokes"
   ],
   "properties": {
    "parent": {
     "type": [
      "string",
      "null"
     ]
    },
    "pivot": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "z": {
     "type": "number"
    },
    "strokes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/stroke"
     }
    },
    "limits": {
     "description": "v0.6: joint limits, [min, max] degrees from the rest pose",
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 2,
     "maxItems": 2
    },
    "attrs": {
     "type": "object",
     "description": "v0.9: free per-part attributes (any JSON values: material, sound, notes); kept by every tool, ignored by the renderers"
    }
   }
  },
  "swap": {
   "type": "object",
   "required": [
    "anchor",
    "shapes"
   ],
   "properties": {
    "anchor": {
     "type": "string"
    },
    "z": {
     "type": "number"
    },
    "talk": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "movable": {
     "type": "number"
    },
    "replaces": {
     "type": "string"
    },
    "shapes": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/stroke"
      }
     }
    },
    "charts": {
     "type": "object",
     "description": "v0.6: emotion -> {viseme shape: drawn shape} (mouth)",
     "additionalProperties": {
      "type": "object",
      "additionalProperties": {
       "type": "string"
      }
     }
    },
    "xsheet": {
     "type": "object",
     "description": "v0.8 drawn levels: the exposure sheet, one drawing name per frame at fps (runs are holds); compiled into the puppet's clip 'play'",
     "required": [
      "fps",
      "cells"
     ],
     "properties": {
      "fps": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "cells": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "minItems": 1
      },
      "loop": {
       "type": "boolean"
      }
     }
    },
    "paint": {
     "type": "object",
     "description": "v0.8 drawn levels: colour styles and the points that paint each drawing's closed areas",
     "properties": {
      "styles": {
       "type": "object",
       "additionalProperties": {
        "type": "string"
       }
      },
      "seeds": {
       "type": "object",
       "additionalProperties": {
        "type": "array",
        "items": {
         "type": "array",
         "minItems": 3,
         "maxItems": 3
        }
       }
      }
     }
    },
    "by_angle": {
     "type": "object",
     "description": "v0.9: drawing substitution driven by a part's angle",
     "required": [
      "part",
      "shapes"
     ],
     "properties": {
      "part": {
       "type": "string"
      },
      "world": {
       "type": "boolean"
      },
      "shapes": {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         },
         {
          "type": "string"
         }
        ]
       }
      }
     }
    }
   }
  },
  "vector": {
   "type": "object",
   "required": [
    "d"
   ],
   "properties": {
    "d": {
     "type": "string"
    },
    "fill": {
     "type": "string"
    },
    "stroke": {
     "type": "string"
    },
    "width": {
     "type": "number"
    },
    "opacity": {
     "type": "number"
    },
    "rule": {
     "enum": [
      "nonzero",
      "evenodd"
     ]
    }
   }
  },
  "raster": {
   "type": "object",
   "description": "v0.3: an image placed in artboard units",
   "required": [
    "image",
    "x",
    "y",
    "w",
    "h"
   ],
   "properties": {
    "image": {
     "type": "string"
    },
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "w": {
     "type": "number"
    },
    "h": {
     "type": "number"
    },
    "opacity": {
     "type": "number"
    },
    "role": {
     "enum": [
      "line",
      "paint"
     ],
     "description": "v0.8 drawn levels: line art, or paint rebuilt from the level's colour styles (sits under the line)"
    }
   }
  },
  "mesh": {
   "type": "object",
   "description": "v0.5: a texture on a skinned triangle mesh",
   "required": [
    "mesh"
   ],
   "properties": {
    "opacity": {
     "type": "number"
    },
    "mesh": {
     "type": "object",
     "required": [
      "image",
      "iw",
      "ih",
      "verts",
      "uv",
      "tris",
      "weights"
     ],
     "properties": {
      "image": {
       "type": "string"
      },
      "iw": {
       "type": "number"
      },
      "ih": {
       "type": "number"
      },
      "grow": {
       "type": "number"
      },
      "verts": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "uv": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      },
      "tris": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "integer"
        },
        "minItems": 3,
        "maxItems": 3
       }
      },
      "weights": {
       "type": "array",
       "items": {
        "type": "array",
        "items": {
         "type": "array",
         "prefixItems": [
          {
           "type": "string"
          },
          {
           "type": "number"
          }
         ]
        }
       }
      }
     }
    }
   }
  }
 }
}
