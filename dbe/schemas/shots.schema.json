{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "doodleberry/shots.schema.json",
 "title": "Doodleberry shot list (shots.json)",
 "type": "object",
 "required": [
  "shots"
 ],
 "$defs": {
  "time": {
   "description": "seconds, or a time relative to a spoken line: \"mid.start+0.9\", \"end.end-0.2\"",
   "oneOf": [
    {
     "type": "number",
     "minimum": 0
    },
    {
     "type": "string",
     "pattern": "^\\s*[\\w-]+\\.(start|end)\\s*([+-]\\s*[0-9.]+)?\\s*$"
    }
   ]
  },
  "key": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "prefixItems": [
    {
     "$ref": "#/$defs/time"
    },
    {}
   ]
  },
  "keys": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/key"
   }
  },
  "place": {
   "type": "object",
   "required": [
    "x",
    "y"
   ],
   "properties": {
    "x": {
     "type": "number"
    },
    "y": {
     "type": "number"
    },
    "s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "flip": {
     "enum": [
      1,
      -1
     ]
    }
   }
  },
  "clip": {
   "type": "object",
   "required": [
    "clip"
   ],
   "properties": {
    "clip": {
     "type": "string"
    },
    "start": {
     "$ref": "#/$defs/time"
    },
    "end": {
     "$ref": "#/$defs/time"
    },
    "weight": {
     "type": "number"
    },
    "fadeIn": {
     "type": "number",
     "minimum": 0
    },
    "fadeOut": {
     "type": "number",
     "minimum": 0
    },
    "additive": {
     "type": "boolean"
    },
    "speed": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "phase": {
     "type": "number",
     "description": "clip seconds to start into the clip (WP-11)"
    }
   }
  },
  "timeline": {
   "type": "object",
   "properties": {
    "clips": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/clip"
     }
    },
    "poses": {
     "$ref": "#/$defs/keys"
    },
    "look": {
     "$ref": "#/$defs/keys"
    },
    "view": {
     "$ref": "#/$defs/keys"
    },
    "visemes_from": {
     "type": "string"
    },
    "springs": {
     "type": "boolean"
    },
    "blink": {
     "type": "boolean"
    },
    "blinks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/time"
     }
    },
    "ik": {
     "type": "object"
    },
    "pins": {
     "type": "object"
    },
    "travel": {
     "type": [
      "number",
      "object"
     ]
    },
    "set": {
     "type": "object"
    },
    "seed": {
     "type": "number"
    },
    "ik_weight": {
     "type": "object",
     "description": "WP-11 IK/FK blend per limb: [[t, 0..1]]"
    },
    "ik_bend": {
     "type": "object",
     "description": "which way an elbow or knee bends per limb (1 or -1)"
    }
   }
  },
  "cast": {
   "type": "object",
   "required": [
    "puppet"
   ],
   "properties": {
    "puppet": {
     "type": "string",
     "pattern": "\\.puppet\\.json$"
    },
    "speaker": {
     "type": "string"
    },
    "place": {
     "oneOf": [
      {
       "$ref": "#/$defs/place"
      },
      {
       "$ref": "#/$defs/path_place"
      },
      {
       "type": "array",
       "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
         {
          "$ref": "#/$defs/time"
         },
         {
          "$ref": "#/$defs/place"
         }
        ]
       }
      }
     ]
    },
    "timeline": {
     "$ref": "#/$defs/timeline"
    },
    "plane": {
     "type": "string",
     "description": "WP-36: the depth plane this cast member is drawn on (default: stage)"
    },
    "outfit": {
     "type": "string",
     "description": "an outfit the puppet carries (meta.outfits, made by the generator's outfits; WP-16)"
    }
   }
  },
  "shot": {
   "type": "object",
   "required": [
    "id",
    "start",
    "end"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_-]+$"
    },
    "renderer": {
     "enum": [
      "svg",
      "synfig",
      "grease-pencil",
      "lottie"
     ]
    },
    "set": {
     "type": "string"
    },
    "palette_variant": {
     "type": "string",
     "enum": [
      "night",
      "sick",
      "cold",
      "warm"
     ],
     "description": "recolour the shot's characters (cast/palette_variants.json, WP-16)"
    },
    "set_opts": {
     "type": "object"
    },
    "start": {
     "$ref": "#/$defs/time"
    },
    "end": {
     "$ref": "#/$defs/time"
    },
    "start_line": {
     "type": "string"
    },
    "end_line": {
     "type": "string"
    },
    "lead": {
     "type": "number"
    },
    "tail": {
     "type": "number"
    },
    "cast": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/cast"
     }
    },
    "camera": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
       {
        "$ref": "#/$defs/time"
       },
       {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
         "type": "number"
        }
       },
       {
        "description": "WP-19: the easing of the move to the next key: smooth (default), linear, hold, or a cubic Bezier [x1, y1, x2, y2]",
        "oneOf": [
         {
          "enum": [
           "smooth",
           "linear",
           "hold"
          ]
         },
         {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
           "type": "number"
          }
         }
        ]
       }
      ]
     }
    },
    "cues": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "t",
       "type"
      ],
      "properties": {
       "t": {
        "$ref": "#/$defs/time"
       },
       "type": {
        "type": "string"
       },
       "gain": {
        "type": "number"
       }
      }
     }
    },
    "captions": {
     "type": "boolean"
    },
    "style": {
     "type": "object"
    },
    "overlays": {
     "type": "array"
    },
    "underlays": {
     "type": "array"
    },
    "fx": {
     "type": "object"
    },
    "bubbles": {},
    "extra_bubbles": {
     "type": "array"
    },
    "comp": {
     "type": "object",
     "description": "WP-36 compositor: depth planes (parallax 1/depth, depth of field from focus and dof) and per-plane nodes (grade, blur, glow, mask, blend, lightwrap), camera roll, keyed values and expressions, tracked regions; see dbe/player/comp.js",
     "properties": {
      "focus": {
       "description": "a number, keys [[t, v], ...] (linear) or an expression \"=...\" (WP-36)",
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2
         }
        },
        {
         "type": "string",
         "pattern": "^="
        }
       ]
      },
      "dof": {
       "description": "a number, keys [[t, v], ...] (linear) or an expression \"=...\" (WP-36)",
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2
         }
        },
        {
         "type": "string",
         "pattern": "^="
        }
       ]
      },
      "planes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "depth": {
          "description": "a number, keys [[t, v], ...] (linear) or an expression \"=...\" (WP-36)",
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "array",
            "items": {
             "type": "array",
             "minItems": 2
            }
           },
           {
            "type": "string",
            "pattern": "^="
           }
          ]
         },
         "set": {
          "type": "string"
         },
         "set_opts": {
          "type": "object"
         },
         "items": {
          "type": "array"
         },
         "drift": {
          "type": "array"
         },
         "opacity": {
          "description": "a number, keys [[t, v], ...] (linear) or an expression \"=...\" (WP-36)",
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "array",
            "items": {
             "type": "array",
             "minItems": 2
            }
           },
           {
            "type": "string",
            "pattern": "^="
           }
          ]
         },
         "screen": {
          "type": "boolean",
          "description": "WP-42: screen-locked (a 3D render already framed by the camera)"
         },
         "proc_plane": {
          "type": "boolean"
         }
        }
       }
      },
      "nodes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "type",
         "plane"
        ],
        "properties": {
         "type": {
          "enum": [
           "grade",
           "blur",
           "glow",
           "mask",
           "blend",
           "lightwrap"
          ]
         },
         "plane": {
          "type": "string"
         }
        }
       }
      },
      "zoom": {
       "enum": [
        "scale",
        "dolly"
       ],
       "description": "WP-42: dolly = true perspective (matches 3D renders framed by the shot camera)"
      },
      "roll": {
       "description": "WP-36: camera roll about the frame centre, degrees; a number, keys [[t, v], ...] (linear) or an expression \"=...\" (WP-36)",
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "array",
         "items": {
          "type": "array",
          "minItems": 2
         }
        },
        {
         "type": "string",
         "pattern": "^="
        }
       ]
      },
      "tracks": {
       "type": "object",
       "description": "WP-36: tracked regions (comp.track): id -> [[t, x, y, luma], ...]",
       "additionalProperties": {
        "type": "array",
        "items": {
         "type": "array",
         "minItems": 3
        }
       }
      }
     }
    },
    "props": {
     "type": "array",
     "description": "props: attach keys (ballistic flights, drops), baked physics tracks, squash/stretch/smear; see dbe/player/props.js",
     "items": {
      "type": "object",
      "properties": {
       "id": {
        "type": "string"
       },
       "r": {
        "type": "number",
        "exclusiveMinimum": 0
       },
       "color": {
        "type": "string"
       },
       "svg": {
        "type": "string"
       },
       "shape": {
        "enum": [
         "ball",
         "box"
        ]
       },
       "size": {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       },
       "gravity": {
        "type": "number"
       },
       "travel": {
        "type": "number"
       },
       "arc": {
        "type": "number"
       },
       "spin": {
        "type": "number"
       },
       "attach": {
        "type": "array",
        "items": {
         "type": "array",
         "minItems": 2,
         "maxItems": 2
        }
       },
       "track": {
        "type": "object",
        "required": [
         "frames"
        ],
        "properties": {
         "t0": {
          "type": "number"
         },
         "fps": {
          "type": "number",
          "exclusiveMinimum": 0
         },
         "frames": {
          "type": "array",
          "items": {
           "type": "array",
           "minItems": 3,
           "maxItems": 3,
           "items": {
            "type": "number"
           }
          }
         },
         "contacts": {
          "type": "array",
          "items": {
           "type": "array"
          }
         }
        }
       },
       "stretch": {
        "type": [
         "boolean",
         "object"
        ]
       },
       "squash": {
        "type": [
         "boolean",
         "object"
        ]
       },
       "smear": {
        "type": [
         "boolean",
         "object"
        ]
       },
       "impact": {
        "type": "boolean"
       },
       "solved": {
        "enum": [
         "juggle",
         "physics"
        ]
       }
      }
     }
    },
    "juggle": {
     "type": "object",
     "description": "WP-09 juggling solver input (juggle.solve): a siteswap on the beat grid",
     "properties": {
      "cast": {
       "type": "integer",
       "minimum": 0
      },
      "pattern": {
       "type": "string",
       "pattern": "^[0-9a-z]+$"
      },
      "start": {
       "type": [
        "number",
        "string"
       ]
      },
      "end": {
       "type": [
        "number",
        "string"
       ]
      },
      "every": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "dwell": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "subdiv": {
       "type": "integer",
       "minimum": 1
      },
      "height": {
       "type": [
        "number",
        "null"
       ]
      },
      "r": {
       "type": [
        "number",
        "null"
       ]
      },
      "balls": {
       "type": "array",
       "items": {
        "type": "object"
       }
      }
     }
    },
    "physics": {
     "type": "object",
     "description": "WP-09 multi-body physics (physics.solve, deterministic Rapier), baked into prop tracks",
     "properties": {
      "start": {
       "type": [
        "number",
        "string"
       ]
      },
      "end": {
       "type": [
        "number",
        "string"
       ]
      },
      "gravity": {
       "type": "number"
      },
      "floor": {
       "type": "number"
      },
      "walls": {
       "type": "boolean"
      },
      "retime": {
       "type": [
        "boolean",
        "string",
        "object"
       ]
      },
      "solved_hash": {
       "type": "string"
      },
      "bodies": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "id"
        ],
        "properties": {
         "id": {
          "type": "string"
         },
         "prop": {
          "type": "boolean"
         },
         "shape": {
          "enum": [
           "ball",
           "box"
          ]
         },
         "r": {
          "type": "number"
         },
         "size": {
          "type": "array"
         },
         "at": {
          "type": "array"
         },
         "v": {
          "type": "array"
         }
        }
       }
      },
      "static": {
       "type": "array",
       "items": {
        "type": "object"
       }
      },
      "impulses": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "t",
         "body"
        ]
       }
      }
     }
    },
    "interact": {
     "type": "object",
     "description": "WP-11 interaction and locomotion (interact.solve): walks along paths, handshakes, eye contact",
     "properties": {
      "walks": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "cast",
         "points"
        ]
       }
      },
      "handshakes": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "a",
         "b"
        ]
       }
      },
      "eye_contact": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "a",
         "b"
        ]
       }
      },
      "solved": {
       "type": "object"
      }
     }
    },
    "proc": {
     "type": "object",
     "description": "WP-42 procedural graph (proc.cook): nodes scatter, crowd, particles, gn_set; cached by content hash",
     "required": [
      "nodes"
     ],
     "properties": {
      "floor": {
       "type": "number"
      },
      "nodes": {
       "type": "object",
       "additionalProperties": {
        "type": "object",
        "required": [
         "op"
        ],
        "properties": {
         "op": {
          "enum": [
           "scatter",
           "crowd",
           "particles",
           "gn_set"
          ]
         },
         "in": {
          "type": [
           "string",
           "array"
          ]
         }
        }
       }
      }
     }
    },
    "transition": {
     "type": "object",
     "description": "WP-15: how this shot comes in from the one before (made when the film is assembled; the cut stays at this shot's start, the transition is centred on it)",
     "required": [
      "kind"
     ],
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "dissolve",
        "wipe",
        "slide",
        "dip",
        "iris"
       ]
      },
      "dur": {
       "oneOf": [
        {
         "type": "number",
         "exclusiveMinimum": 0,
         "maximum": 3
        },
        {
         "const": "auto"
        }
       ],
       "description": "seconds (default 0.5), or \"auto\": long enough for the seam check, from how different the shots are across the cut (up to 1 s each side)"
      },
      "dir": {
       "enum": [
        "left",
        "right",
        "up",
        "down"
       ],
       "description": "wipe and slide: the way the edge moves (default left)"
      },
      "color": {
       "enum": [
        "black",
        "white"
       ],
       "description": "dip: the colour it dips through (default black)"
      }
     }
    },
    "describe": {
     "description": "WP-24: the audio description's words for this shot's start (replacing the generated ones); false: leave it undescribed",
     "oneOf": [
      {
       "type": "string"
      },
      {
       "const": false
      }
     ]
    },
    "ots": {
     "type": "object",
     "description": "WP-19: an over-the-shoulder shot made by shot.ots: whom we look past (seen from behind, near the camera) and whom we look at; film.continuity names the shot's size from `on`",
     "required": [
      "over",
      "on"
     ],
     "properties": {
      "over": {
       "type": "string"
      },
      "on": {
       "type": "string"
      },
      "size": {
       "enum": [
        "MS",
        "MCU",
        "CU"
       ]
      }
     }
    }
   }
  },
  "path_place": {
   "type": "object",
   "required": [
    "path"
   ],
   "description": "WP-11: walk along a path (Catmull-Rom through the points, frame px); see puppet/loader/acting.js pathAt",
   "properties": {
    "path": {
     "type": "object",
     "required": [
      "points"
     ],
     "properties": {
      "points": {
       "type": "array",
       "minItems": 1,
       "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
         "type": "number"
        }
       }
      },
      "start": {
       "$ref": "#/$defs/time"
      },
      "end": {
       "$ref": "#/$defs/time"
      },
      "speed": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "ease": {
       "type": "number",
       "minimum": 0
      },
      "s": {
       "type": "number",
       "exclusiveMinimum": 0
      },
      "s_by_y": {
       "type": "array",
       "minItems": 4,
       "maxItems": 4,
       "items": {
        "type": "number"
       }
      },
      "face": {
       "enum": [
        "auto",
        1,
        -1
       ]
      }
     }
    }
   }
  }
 },
 "properties": {
  "title": {
   "type": "string"
  },
  "size": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "items": {
    "type": "integer",
    "minimum": 64
   }
  },
  "fps": {
   "type": "integer",
   "minimum": 1,
   "maximum": 120
  },
  "captions": {
   "type": "boolean"
  },
  "caption_style": {
   "type": "object"
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "$ref": "#/$defs/shot"
   }
  },
  "hooks": {
   "type": "object"
  },
  "aspects": {
   "type": "object"
  },
  "brief": {
   "type": "object"
  },
  "post": {
   "description": "finishing: a preset name or {preset, grade, vignette, grain, lut}",
   "oneOf": [
    {
     "type": "string",
     "enum": [
      "crisp",
      "film",
      "warm",
      "cool",
      "paper",
      "noir"
     ]
    },
    {
     "type": "object"
    }
   ]
  },
  "foley": {
   "type": "boolean",
   "description": "automatic foley from the motion (plan 2.7)"
  },
  "timewarp": {
   "description": "sound-off cut (plan 2.13): [[cut time, film time], ...] knots, increasing; written by film.soundoff",
   "type": "array",
   "items": {
    "type": "array",
    "minItems": 2,
    "maxItems": 2,
    "items": {
     "type": "number"
    }
   }
  },
  "caption_lines": {
   "description": "only these line ids are burned in as captions (the sound-off cut captions lines that get no bubble)",
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "soundoff": {
   "description": "film.render also makes the bubble-only sound-off cut (true, or film.soundoff options)",
   "oneOf": [
    {
     "type": "boolean"
    },
    {
     "type": "object"
    }
   ]
  },
  "beat_cuts": {
   "description": "plan 2.14: move each shot change onto the bar line (else beat) of the score in the pause it falls in",
   "type": "boolean"
  },
  "brand": {
   "description": "true: the house brand kit (brand/brand.json); a string: brand/<id>.json, a channel's own kit (WP-32)",
   "oneOf": [
    {
     "type": "boolean"
    },
    {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9_-]{0,40}$"
    }
   ]
  },
  "audio_description": {
   "description": "WP-24: audio description made with every render (film.describe). false: none; an object passes options (voice, extend)",
   "oneOf": [
    {
     "type": "boolean"
    },
    {
     "type": "object",
     "properties": {
      "voice": {
       "type": "string"
      },
      "extend": {
       "type": "boolean"
      }
     },
     "additionalProperties": false
    }
   ]
  },
  "lang": {
   "type": "string",
   "description": "WP-25: the film's language (BCP 47 tag)"
  },
  "dir": {
   "enum": [
    "ltr",
    "rtl"
   ],
   "description": "WP-25: reading direction; rtl mirrors left-aligned text and boards"
  },
  "locale": {
   "type": "string",
   "description": "WP-25: locale for numbers and dates on screen (BCP 47, e.g. ar or ar-u-nu-arab for Arabic-Indic digits)"
  },
  "sign": {
   "type": "boolean",
   "description": "WP-26: sign the finals with C2PA content credentials (default true)"
  },
  "branches": {
   "type": "array",
   "description": "WP-30 branching for the interactive page: after a shot the viewer chooses; each choice is a run of shots; all meet at 'then'. The rendered film holds every branch in order.",
   "items": {
    "type": "object",
    "required": [
     "after",
     "choices",
     "then"
    ],
    "properties": {
     "after": {
      "type": "string"
     },
     "prompt": {
      "type": "string"
     },
     "then": {
      "type": "string"
     },
     "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "shots"
       ],
       "properties": {
        "label": {
         "type": "string"
        },
        "shots": {
         "type": "array",
         "items": {
          "type": "string"
         },
         "minItems": 1
        }
       }
      }
     }
    }
   }
  }
 }
