     "start": 6.015,
     "end": 6.34
    },
    {
     "text": "see?",
     "start": 6.415,
     "end": 6.749
    }
   ]
  },
  {
   "id": "a1",
   "speaker": "ravi",
   "fact": null,
   "text": "Its big lens or mirror gathers far more light than your eye can.",
