{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "doodleberry/script.schema.json",
 "title": "Doodleberry script (script.json)",
 "type": "object",
 "required": ["lines"],
 "properties": {
  "voice": {"type": "string"},
  "speakers": {"type": "object", "additionalProperties": {"type": "object", "required": ["voice"], "properties": {
    "voice": {"type": "string"}, "fx": {"oneOf": [{"type": "string"}, {"type": "object"}]}}}},
  "lang": {"type": "string"}, "fps": {"type": "integer"},
  "length_scale": {"type": "number", "exclusiveMinimum": 0}, "gap_s": {"type": "number", "minimum": 0}, "lead_in_s": {"type": "number", "minimum": 0},
  "allow_restricted_voices": {"type": "boolean"}, "voice_licence_note": {"type": "string"},
  "lines": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "text"], "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "speaker": {"type": "string"}, "text": {"type": "string", "minLength": 1},
    "fact": {"type": ["string", "array", "null"]}, "pause": {"type": "number", "minimum": 0}, "style": {"enum": ["say", "shout", "whisper", "thought", "narration"]},
    "bubble": {"type": "string"}}}}
 }
}
